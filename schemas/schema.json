{
  "base_entity_schema": {
    "required_properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier automatically generated for the Entity."
      },
      "name": {
        "type": "string",
        "description": "Human-readable name of the Entity."
      },
      "type": {
        "type": "string",
        "description": "Entity Type defined by the selected domain."
      },
      "beginning_of_process": {
        "type": "boolean",
        "description": "Defines whether the Entity marks the beginning of the process."
      },
      "end_of_process": {
        "type": "boolean",
        "description": "Defines whether the Entity marks the end of the process."
      }
    }
  },

"base_flow_object_schema": {
  "required_properties": {
    "name": {
      "type": "string",
      "description": "Human-readable name of the Flow Object."
    }
  },

  "properties": {
    "entry_entity": {
      "type": "string",
      "description": "Identifier of the Processing Entity where the Flow Object enters the model."
    },
    "generation_interval": {
      "type": "number",
      "unit": "s",
      "description": "Time interval between generated Flow Objects."
    },
    "batch_size": {
      "type": "number",
      "unit": "piece",
      "description": "Number of Flow Objects generated at each generation event."
    }
    
  },

  "process_requirements": {
    "type": "object",
    "description": "Defines the required Process Supply quantities for each Processing Entity.",
    "structure": {
      "processing_entity_id": {
        "type": "object",
        "description": "Processing Entity and its required Process Supply quantities.",
        "structure": {
          "process_supply_entity_id": {
            "type": "number",
            "unit": "piece",
            "description": "Required quantity of the Process Supply."
          }
        }
      }
    }
  }
},

  "base_relationship_schema": {
    "required_properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier automatically generated for the Relationship."
      },
      "source": {
        "type": "string",
        "description": "Identifier of the source Entity."
      },
      "target": {
        "type": "string",
        "description": "Identifier of the target Entity."
      }
    }
  },

  "domains": [
    {
      "name": "Production",
      "description": "The Production domain provides modelling guidance for production-oriented Entity Types / Roles and their relevant Properties, Relationships, and Rule Templates. These are modelling recommendations; they do not define hard-coded simulation behaviour.",

      "entity_types": [
        "Processing",
        "Inspection",
        "Storage",
        "Transport",
        "Process Supply",
        "Process Sink"
      ],

      "rule_templates": [
        "Routing",
        "Eligibility",
        "State Change",
        "Failure",
        "Generation",
        "Capacity"
      ],

      "entity_schemas": [
        {
          "type": "Processing",
          "input_min": 1,
          "input_max": 7,
          "output_min": 1,
          "output_max": 2,
          "hierarchy": {
            "role": "main",
            "position": "center"
          },
          "properties": {
            "processing_time": {
              "type": "number",
              "unit": "s",
              "description": "Time required to process one Flow Object."
            },
            "capacity": {
              "type": "number",
              "unit": "piece",
              "description": "Maximum number of Flow Objects processed at once."
            }
          }
        },

        {
          "type": "Inspection",
          "input_min": 1,
          "input_max": 1,
          "output_min": 1,
          "output_max": 2,
          "hierarchy": {
            "role": "main",
            "position": "center"
          },
          "properties": {
            "inspection_time": {
              "type": "number",
              "unit": "s",
              "description": "Time required to inspect one Flow Object."
            },
            "capacity": {
              "type": "number",
              "unit": "piece",
              "description": "Maximum number of Flow Objects inspected at once."
            }
          }
        },

        {
          "type": "Storage",
          "input_min": 1,
          "input_max": 1,
          "output_min": 1,
          "output_max": 2,
          "hierarchy": {
            "role": "main",
            "position": "center"
          },
          "properties": {
            "capacity": {
              "type": "number",
              "unit": "piece",
              "description": "Maximum number of Flow Objects that can be stored."
            },
            "initial_inventory": {
              "type": "number",
              "unit": "piece",
              "description": "Initial quantity of Flow Objects in the Storage."
            },
            "queue_rule": {
              "type": "string",
              "description": "Rule determining the order in which Flow Objects leave the Storage."
            }
          }
        },

        {
          "type": "Transport",
          "input_min": 1,
          "input_max": 1,
          "output_min": 1,
          "output_max": 1,
          "hierarchy": {
            "role": "main",
            "position": "center"
          },
          "properties": {
            "transport_time": {
              "type": "number",
              "unit": "s",
              "description": "Time required to transport one Flow Object."
            },
            "capacity": {
              "type": "number",
              "unit": "piece",
              "description": "Maximum number of Flow Objects that can be transported at once."
            }
          }
        },

        {
          "type": "Process Supply",
          "input_min": 0,
          "input_max": 0,
          "output_min": 1,
          "output_max": 1,
          "hierarchy": {
            "role": "secondary",
            "position": "above"
          },
          "properties": {
            "capacity": {
              "type": "number",
              "unit": "piece",
              "description": "Maximum quantity of supplied material available."
            },
            "initial_quantity": {
              "type": "number",
              "unit": "piece",
              "description": "Initial quantity of supplied material."
            },
            "replenishment_interval": {
              "type": "number",
              "unit": "s",
              "description": "Time interval between replenishment events."
            },
            "replenishment_quantity": {
              "type": "number",
              "unit": "piece",
              "description": "Quantity added at each replenishment event."
            },
            "unit": {
              "type": "string",
              "description": "Unit of measurement for the Process Supply."
            }
          }
        },

        {
          "type": "Process Sink",
          "input_min": 1,
          "input_max": 1,
          "output_min": 0,
          "output_max": 0,
          "hierarchy": {
            "role": "secondary",
            "position": "below"
          },
          "properties": {}
        }
      ],

      "relationship_allowances": {
        "Processing": [
          "Processing",
          "Inspection",
          "Storage",
          "Transport",
          "Process Sink"
        ],
        "Inspection": [
          "Processing",
          "Inspection",
          "Storage",
          "Transport",
          "Process Sink"
        ],
        "Storage": [
          "Processing",
          "Inspection",
          "Transport"
        ],
        "Transport": [
          "Processing",
          "Inspection",
          "Transport",
          "Storage",
          "Process Sink"
        ],
        "Process Supply": [
          "Processing"
        ]
      }
    }
  ]
}